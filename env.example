# Database Configuration
DATABASE_URL=mysql://username:password@localhost/database_name

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# CORS Configuration
# For development: CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# For production: CORS_ORIGINS=https://app.zestal.pro,http://147.93.183.79,http://147.93.183.79:3000,http://147.93.183.79:3001
# For multiple domains: CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.zestal.pro
CORS_ORIGINS=https://app.zestal.pro,http://localhost:3000,http://localhost:3001,http://147.93.183.79,http://147.93.183.79:3000,http://147.93.183.79:3001

# Base URL
BASE_URL=https://app.zestal.pro/api

# Frontend URL for OAuth redirects
FRONTEND_URL=https://app.zestal.pro

# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Facebook OAuth Configuration
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_OAUTH_REDIRECT_URI=https://app.zestal.pro/api/auth/facebook/callback

# Facebook App Configuration (for token refresh and API calls)
# Usually same as CLIENT_ID and CLIENT_SECRET
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Facebook Webhook Configuration
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-random-secure-token-here

# Twilio Configuration (use Test Credentials for sandbox)
# Get test creds from: https://console.twilio.com → Account → API keys
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Vapi AI Voice Configuration
# Get API key from: https://dashboard.vapi.ai
VAPI_API_KEY=your-vapi-api-key
VAPI_WEBHOOK_URL=https://your-domain.com/api/webhooks/vapi
VAPI_WEBHOOK_SECRET=your-random-webhook-secret
VAPI_SHARED_ASSISTANT_ID=

# Phone Pool Configuration
PHONE_POOL_MAX_SIZE=50
PHONE_POOL_AUTO_PROVISION=true
